# Port to run the server on
PORT=5000

# Neon PostgreSQL connection string (do not commit actual secrets)
DATABASE_URL=postgres://username:password@hostname/dbname?sslmode=require

# Admin Seed Credentials
ADMIN_NAME=ISP Administrator
ADMIN_EMAIL=admin@yourisp.com
ADMIN_PASSWORD=CHANGE_THIS_TO_MY_PASSWORD

# JWT Secret
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

